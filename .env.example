# Skopiuj do .env i uzupełnij. .env NIGDY nie trafia do repo (patrz .gitignore).

# --- Źródła danych ---
FOOTBALL_DATA_API_KEY=your_football_data_org_token

# --- Google Cloud ---
GCP_PROJECT_ID=your-gcp-project-id
GCS_RAW_BUCKET=your-raw-bucket-name
GCP_REGION=us-central1
# Ścieżka do klucza service accountu (plik poza repo!)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
